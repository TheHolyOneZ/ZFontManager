{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZFontManager",
  "version": "0.1.0",
  "identifier": "com.theholyonez.zfontmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZFontManager",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false,
        "decorations": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/fonts/**",
          "$HOME/.local/share/fonts/**",
          "$HOME/.fonts/**",
          "$HOME/Library/Fonts/**",
          "/Library/Fonts/**",
          "/System/Library/Fonts/**",
          "$HOME/AppData/Local/Microsoft/Windows/Fonts/**",
          "C:/Windows/Fonts/**",
          "$APPDATA/**",
          "$LOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TheHolyOneZ",
    "copyright": "Copyright © 2026 TheHolyOneZ",
    "category": "Utility",
    "homepage": "https://zsync.eu/zfontmanager/",
    "shortDescription": "The free, open-source font manager for Linux, Windows and macOS.",
    "longDescription": "ZFontManager by TheHolyOneZ — preview, tag, activate/deactivate, and install fonts across Linux, Windows and macOS from one clean native app. Free software under GPL-3.0.",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
